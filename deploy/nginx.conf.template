# Cloudflare published IPs, verified 2026-09-30.
# Sources: https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
geo $realip_remote_addr $klock_cloudflare_peer {
    default 0;
    173.245.48.0/20 1;
    103.21.244.0/22 1;
    103.22.200.0/22 1;
    103.31.4.0/22 1;
    141.101.64.0/18 1;
    108.162.192.0/18 1;
    190.93.240.0/20 1;
    188.114.96.0/20 1;
    197.234.240.0/22 1;
    198.41.128.0/17 1;
    162.158.0.0/15 1;
    104.16.0.0/13 1;
    104.24.0.0/14 1;
    172.64.0.0/13 1;
    131.0.72.0/22 1;
    2400:cb00::/32 1;
    2606:4700::/32 1;
    2803:f800::/32 1;
    2405:b500::/32 1;
    2405:8100::/32 1;
    2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}
map "$klock_cloudflare_peer:$http_x_forwarded_proto" $klock_edge_https {
    default 0;
    "1:https" 1;
}
server {
    listen 80;
    listen [::]:80;
    server_name ${KLOCK_DOMAIN};
    access_log off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/klock-acme;
        default_type text/plain;
    }
    client_max_body_size 64k;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        if ($klock_edge_https = 0) { return 301 https://${KLOCK_DOMAIN}$request_uri; }
        proxy_pass http://127.0.0.1:5188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Server;
    }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${KLOCK_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${KLOCK_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${KLOCK_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    access_log off;
    client_max_body_size 64k;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:5188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_hide_header Server;
    }
}
