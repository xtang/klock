# Copy to .env and fill in locally. Never commit .env or share the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KLOCK_BASE_URL=http://localhost:5188
# Google Cloud authorized redirect URI:
# http://localhost:5188/api/auth/google/callback

# Required for first workspace creation on HTTPS production deployments.
KLOCK_BOOTSTRAP_EMAIL=
